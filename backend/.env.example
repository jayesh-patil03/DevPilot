# Copy this file to .env and replace the placeholder values.
# run-local.ps1 loads .env before starting Spring Boot.
# Keep DB_PASSWORD in sync with the root .env used by Docker Compose.
DB_URL=jdbc:postgresql://localhost:5433/devpilot
DB_USERNAME=postgres
DB_PASSWORD=replace-for-local-or-production
GEMINI_API_KEY=replace-with-a-new-key
GITHUB_CLIENT_ID=replace-with-your-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-your-oauth-app-client-secret
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TOKEN_ENCRYPTOR_PASSWORD=replace-with-a-long-random-secret
TOKEN_ENCRYPTOR_SALT=replace-with-16-hex-characters